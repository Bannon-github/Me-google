{
  "$description": "HIGH-CONTRAST override layer for me-google-default. Sparse patch merged over base tokens when high-contrast mode is active (ADR-005 §2). Targets >= 15:1 (near #000/#fff ~21:1), removes transparency/glow, bolds text weights.",
  "color": {
    "$type": "color",
    "surface": {
      "sunken": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" }, "$extensions": { "dev.me-google.linear": [0, 0, 0] } },
      "base": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" }, "$extensions": { "dev.me-google.linear": [0, 0, 0] } },
      "raised": { "$value": { "colorSpace": "srgb", "components": [0.043, 0.043, 0.043], "hex": "#0B0B0B" }, "$extensions": { "dev.me-google.linear": [0.00335, 0.00335, 0.00335] } },
      "overlay": { "$value": { "colorSpace": "srgb", "components": [0.078, 0.078, 0.078], "hex": "#141414" }, "$extensions": { "dev.me-google.linear": [0.00961, 0.00961, 0.00961] } }
    },
    "on-surface": {
      "default": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" }, "$extensions": { "dev.me-google.linear": [1, 1, 1] } },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.902, 0.902, 0.902], "hex": "#E6E6E6" }, "$extensions": { "dev.me-google.linear": [0.79, 0.79, 0.79] } },
      "subtle": { "$value": { "colorSpace": "srgb", "components": [0.831, 0.831, 0.831], "hex": "#D4D4D4" }, "$extensions": { "dev.me-google.linear": [0.65, 0.65, 0.65] } }
    },
    "utility": {
      "focus-ring": { "$value": { "colorSpace": "srgb", "components": [1, 0.902, 0], "hex": "#FFE600" }, "$description": "Maximum-visibility yellow focus ring.", "$extensions": { "dev.me-google.linear": [1, 0.79, 0] } },
      "border": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" }, "$description": "Solid white borders (no transparency).", "$extensions": { "dev.me-google.linear": [1, 1, 1] } },
      "glow": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" }, "$description": "Glow removed — solid instead of translucent.", "$extensions": { "dev.me-google.linear": [1, 1, 1] } }
    }
  },
  "typography": {
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 500, "$description": "Body weight bumped to medium for legibility." },
      "medium": { "$value": 600 },
      "semibold": { "$value": 700 },
      "bold": { "$value": 800 }
    }
  }
}
