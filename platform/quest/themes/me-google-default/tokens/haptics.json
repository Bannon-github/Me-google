{
  "$description": "Haptic tokens for me-google-default. Controller haptic patterns: intensity [0,1], duration, frequency (Hz). Every interactive visual affordance has a haptic pattern so feedback survives with vision reduced (ADR-005 §5).",
  "haptics": {
    "$type": "haptic",
    "master": {
      "intensity": { "$type": "number", "$value": 0.8, "$description": "Global haptic intensity scale [0,1]." },
      "enabled": { "$type": "number", "$value": 1, "$description": "1 = haptics enabled by default (user/OS can disable)." }
    },
    "pattern": {
      "focus": {
        "intensity": { "$type": "number", "$value": 0.2 },
        "duration": { "$type": "duration", "$value": { "value": 10, "unit": "ms" } },
        "frequency": { "$type": "number", "$value": 160, "$description": "Hz" },
        "$description": "Light tick on focus/hover."
      },
      "select": {
        "intensity": { "$type": "number", "$value": 0.5 },
        "duration": { "$type": "duration", "$value": { "value": 20, "unit": "ms" } },
        "frequency": { "$type": "number", "$value": 200, "$description": "Hz" },
        "$description": "Confirming pulse on selection."
      },
      "back": {
        "intensity": { "$type": "number", "$value": 0.35 },
        "duration": { "$type": "duration", "$value": { "value": 15, "unit": "ms" } },
        "frequency": { "$type": "number", "$value": 140, "$description": "Hz" },
        "$description": "Soft pulse on back/dismiss."
      },
      "success": {
        "intensity": { "$type": "number", "$value": 0.6 },
        "duration": { "$type": "duration", "$value": { "value": 40, "unit": "ms" } },
        "frequency": { "$type": "number", "$value": 220, "$description": "Hz" },
        "$description": "Double-tap success feedback."
      },
      "error": {
        "intensity": { "$type": "number", "$value": 0.8 },
        "duration": { "$type": "duration", "$value": { "value": 60, "unit": "ms" } },
        "frequency": { "$type": "number", "$value": 90, "$description": "Hz" },
        "$description": "Strong low-frequency buzz for error."
      },
      "notification": {
        "intensity": { "$type": "number", "$value": 0.4 },
        "duration": { "$type": "duration", "$value": { "value": 25, "unit": "ms" } },
        "frequency": { "$type": "number", "$value": 180, "$description": "Hz" },
        "$description": "Gentle notification pulse."
      }
    }
  }
}
